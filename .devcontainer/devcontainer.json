{
  "name": "sangoku-sim",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.encoding": "utf8",
        "files.eol": "\n",
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "static preview",
      "onAutoForward": "openPreview"
    }
  },
  "remoteUser": "vscode"
}
